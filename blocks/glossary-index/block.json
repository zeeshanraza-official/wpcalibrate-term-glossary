{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcalibrate/glossary-index",
	"version": "1.0.0",
	"title": "Glossary Index",
	"category": "widgets",
	"icon": "book-alt",
	"description": "Display an interactive A-Z glossary index with search and category filtering.",
	"keywords": [
		"glossary",
		"terms",
		"dictionary",
		"wpcalibrate"
	],
	"textdomain": "wpcalibrate-term-glossary",
	"attributes": {
		"category": {
			"type": "string",
			"default": ""
		},
		"search": {
			"type": "boolean",
			"default": true
		},
		"alphabet": {
			"type": "boolean",
			"default": true
		},
		"per_page": {
			"type": "number",
			"default": 20
		},
		"order": {
			"type": "string",
			"default": "asc"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "wpctg-glossary-index-block-editor",
	"editorStyle": "wpctg-glossary-index-block-editor-style"
}
